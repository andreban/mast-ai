    "bump-version": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.3",
    "typescript-eslint": "^8.59.1"
  }
}

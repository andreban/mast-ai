{
  "name": "@mast-ai/react-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles/default.css"
  },
  "scripts": {
    "build": "vite build && tsc",
    "prepare": "vite build && tsc",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "peerDependencies": {
    "@mast-ai/core": "*",
    "@tanstack/react-virtual": ">=3.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "rehype-sanitize": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mast-ai/core": "*",
    "@tanstack/react-virtual": "^3.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "~6.0.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
